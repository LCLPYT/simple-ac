{
  "schemaVersion": 1,
  "id": "testmod",
  "version": "${version}",
  "name": "Test Mod",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://github.com/LCLPYT/fabric-kotlin-kickstarter",
    "sources": "https://github.com/LCLPYT/fabric-kotlin-kickstarter"
  },
  "license": "CC0-1.0",
  "icon": "assets/testmod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.ExampleMod"
    ],
    "client": [
      "com.example.ExampleModClient"
    ],
    "fabric-datagen": [
      "com.example.ExampleModDataGenerator"
    ]
  },
  "mixins": [
    "testmod.mixins.json",
    {
      "config": "testmod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_compat}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_language_kotlin}"
  },
  "suggests": {}
}