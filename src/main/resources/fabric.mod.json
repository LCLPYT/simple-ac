{
  "schemaVersion": 1,
  "id": "simple-ac",
  "version": "${version}",
  "name": "Simple Anti-Cheat",
  "description": "Simple anti-cheat for Minecraft servers ",
  "authors": [
    "LCLP"
  ],
  "contact": {
    "homepage": "https://github.com/LCLPYT/simple-ac",
    "sources": "https://github.com/LCLPYT/simple-ac"
  },
  "license": "MIT",
  "icon": "assets/simple-ac/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "work.lclpnet.ac.SimpleAcInit"
    ],
    "client": [
      "work.lclpnet.ac.SimpleAcClientInit"
    ]
  },
  "mixins": [
    "simple-ac.mixins.json",
    {
      "config": "simple-ac.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_compat}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_language_kotlin}"
  },
  "suggests": {}
}